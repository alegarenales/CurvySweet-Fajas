---
import CartDrawer from './CartDrawer.astro';
import './CSS/shop.css';
import { ProductRepository } from '../repositories/ProductRepository';
import { isSafeImagePath } from '../lib/security/validation';

const products = await ProductRepository.getProducts();

// Las rutas de imagen se interpolan dentro de un atributo `style`. Si alguien
// consiguiera guardar en el catálogo una ruta con comillas, podría inyectar
// CSS. Solo dejamos pasar rutas relativas de nuestro propio sitio.
const safeImage = (value: string) => (isSafeImagePath(value) ? value : '');
---
<section class="shop-section" id="shop">
	<div class="shop-header">
		<p class="shop-kicker">CurvySweet</p>
		<h2>Tienda</h2>
		<p class="shop-subtitle">Descubre nuestras piezas más vendidas para realzar tu figura.</p>
	</div>

	<div class="shop-grid">
		{
			products.map((product) => (
				<article
					class="product-card"
					role={product.link ? 'link' : undefined}
					tabindex={product.link ? '0' : undefined}
					data-product-id={product.id}
					data-product-link={product.link ?? ''}
					style={product.link ? 'cursor: pointer;' : ''}
				>
					<div class="product-card-top">
						<span class="product-tag">{product.tag}</span>

						<div class="product-card-actions">

							<button
								type="button"
								class="favorite-button"
								data-favorite-button
								data-product-id={product.id}
								aria-label="Añadir a favoritos"
							>
								♡
							</button>

							<span
								class={`stock-indicator ${product.inStock ? 'is-in-stock' : 'is-out-of-stock'}`}
								data-product-stock={product.id}
								aria-label={product.inStock ? 'Producto en stock' : 'Producto sin stock'}
								title={product.inStock ? 'Producto en stock' : 'Producto sin stock'}
							>
								<span class="stock-dot"></span>
								<span class="stock-text" data-stock-text>
									{product.inStock ? 'En stock' : 'Sin stock'}
								</span>
							</span>

						</div>
					</div>
					<div
						class="product-image"
						role="img"
						aria-label={product.name}
						data-product-images={product.images?.join('|') ?? (product.image ?? '')}
					>
						<div
							class="product-image-layer is-active"
							data-image-primary
							data-product-image={product.id}
							style={safeImage(product.image)
								? `background-image: url('${safeImage(product.image)}');`
								: `background-image: radial-gradient(circle at 75% 20%, rgba(255, 255, 255, 0.7), transparent 55%), linear-gradient(135deg, #ff8fcb, #f04aa8);`}
						></div>
						<div class="product-image-layer" data-image-secondary></div>
					</div>
					<h3 data-product-name={product.id}>{product.name}</h3>
					{/* <p>{product.description}</p> */}
					<div class="product-footer">
						<strong data-product-price={product.id}>{product.displayPrice}</strong>
                        <button
                            type="button"
                            class="add-button"
                            data-cart-add
                            data-product-id={product.id}
                            data-in-stock={product.inStock}
						>
							Añadir al carrito
						</button>
					</div>
				</article>
			))
		}
	</div>
	<div id="popupWarning" class="popup-warning hidden" role="dialog" aria-modal="true" aria-labelledby="popup-title">
		<div class="popup-card">
			<div class="popup-icon" aria-hidden="true">!</div>
			<h3 id="popup-title">Atencion</h3>
			<p id="checkout-error" class="popup-message" role="alert" aria-live="polite"></p>
			<button id="btnClose" class="popup-close" type="button">Entendido</button>
		</div>
	</div>
</section>
<CartDrawer />

<script>
const imageRotators = new WeakMap();

// Estos manejadores estaban antes como atributos `onclick`/`onkeydown` en el
// HTML. Se han pasado a delegación de eventos para que la política de seguridad
// de contenido pueda prohibir todo el JavaScript en línea (`script-src 'self'`),
// que es lo que corta de raíz la mayoría de los ataques de XSS.
const followProductCard = (card) => {
    const productLink = card.dataset.productLink;

    // Solo navegamos a rutas internas: si el enlace del catálogo apuntara a
    // otro dominio, no lo seguimos.
    if (productLink && /^\/[^/\\]/.test(productLink)) {
        window.location.href = productLink;
    }
};

document.addEventListener('click', (event) => {
    const card = event.target.closest('.product-card[data-product-link]');

    if (!card || event.target.closest('[data-cart-add]') || event.target.closest('[data-favorite-button]')) {
        return;
    }

    followProductCard(card);
});

document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') {
        return;
    }

    const card = event.target.closest?.('.product-card[data-product-link]');

    if (!card) {
        return;
    }

    event.preventDefault();
    followProductCard(card);
});

const resetProductRotator = (imageElement) => {
    const state = imageRotators.get(imageElement);

    if (!state) {
        return;
    }

    window.clearInterval(state.intervalId);
    state.index = 0;
    state.activeLayer = 'primary';
    state.intervalId = 0;
    state.primary.style.backgroundImage = `url('${state.images[0]}')`;
    state.primary.classList.add('is-active');
    state.secondary.classList.remove('is-active');
    imageRotators.set(imageElement, state);
};

const startProductRotator = (imageElement) => {
    const images = (imageElement.dataset.productImages || '')
        .split('|')
        .map((image) => image.trim())
        .filter(Boolean);

    if (images.length < 2) {
        return;
    }

    const primary = imageElement.querySelector('[data-image-primary]');
    const secondary = imageElement.querySelector('[data-image-secondary]');

    if (!primary || !secondary) {
        return;
    }

    const currentState = imageRotators.get(imageElement);

    if (currentState?.intervalId) {
        return;
    }

    const state = currentState ?? {
        images,
        index: 0,
        intervalId: 0,
        activeLayer: 'primary',
        primary,
        secondary,
    };

    state.primary.style.backgroundImage = `url('${images[0]}')`;

    state.intervalId = window.setInterval(() => {
        state.index = (state.index + 1) % images.length;
        const nextImage = images[state.index];
        const showPrimary = state.activeLayer === 'secondary';
        const nextLayer = showPrimary ? state.primary : state.secondary;
        const currentLayer = showPrimary ? state.secondary : state.primary;

        nextLayer.style.backgroundImage = `url('${nextImage}')`;
        nextLayer.classList.add('is-active');
        currentLayer.classList.remove('is-active');
        state.activeLayer = showPrimary ? 'primary' : 'secondary';
    }, 850);

    imageRotators.set(imageElement, state);
};

document.querySelectorAll('.product-image').forEach((imageElement) => {
    imageElement.addEventListener('mouseenter', () => {
        startProductRotator(imageElement);
    });

    imageElement.addEventListener('mouseleave', () => {
        resetProductRotator(imageElement);
    });
});
async function loadFavorites() {

    const response = await fetch("/api/favorites");

    if (!response.ok) return;

    const favorites = await response.json();

    const ids = new Set(
        favorites.map(f => f.ProductoId)
    );

    document
        .querySelectorAll("[data-favorite-button]")
        .forEach(button => {

            if (ids.has(button.dataset.productId)) {
                button.classList.add("is-favorite");
                button.textContent = "♥";
            }

        });

}

loadFavorites();

const buttons = document.querySelectorAll("[data-favorite-button]");

buttons.forEach((button) => {

    button.addEventListener("click", async (e) => {

        e.preventDefault();
        e.stopPropagation();

        const productId = button.dataset.productId;
        const favorite = button.classList.contains("is-favorite");

        const response = await fetch("/api/favorites", {
            method: favorite ? "DELETE" : "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ productId })
        });

        if (!response.ok) {
            console.error("Error llamando a la API de favoritos.");
            return;
        }

        button.classList.toggle("is-favorite");
        button.textContent = button.classList.contains("is-favorite")
            ? "♥"
            : "♡";

    });

});

</script>
