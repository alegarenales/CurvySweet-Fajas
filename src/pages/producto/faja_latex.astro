---
import '../../../src/components/CSS/faja_chaleco_cinturilla.css';
import UserMenu from '../../components/UserMenu.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { getProductPageById, getRelatedProducts } from '../../lib/product_info';
import BarMenu from '../../components/BarMenu.astro';

// const product = getProductPageById('faja_latex');
const product = await getProductPageById('faja_latex');

if (!product) {
	throw new Error('No se encontró la información del producto faja_latex');
}

const relatedProducts = await getRelatedProducts(product.id);
const primaryImage = product.gallery[0] ?? product.image ?? '';
const secondaryImages = product.gallery.slice(1);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/curvysweet.ico" />
		<title>{product.name} | CurvySweet</title>
	</head>
	<body>
		<BarMenu showCart={true} />
		<div class="product-page">
			<main class="product-detail">
				<section class="product-hero">
					<div class="product-gallery" data-product-gallery data-gallery-images={product.gallery.join('|')}>
						<div class="product-main-image">
							<button
								type="button"
								class="product-image-frame"
								aria-label={product.name}
								data-product-image={product.id}
								data-gallery-main
								data-gallery-open
								style={`background-image: url('${primaryImage}');`}
							></button>
						</div>

						{secondaryImages.length > 0 && (
							<div class="product-thumb-grid">
								{
									secondaryImages.map((image, index) => (
										<button
											type="button"
											class="product-thumb"
											aria-label={`${product.name} vista ${index + 2}`}
											data-gallery-thumb
											data-gallery-index={index + 1}
											style={`background-image: url('${image}');`}
										></button>
									))
								}
							</div>
						)}
					</div>

					<div class="product-summary">
						<p class="product-kicker">{product.heroLabel}</p>
						<div class="product-title-row">
							<h1 data-product-name={product.id}>{product.name}</h1>
							<span class={`stock-indicator ${product.inStock ? 'is-in-stock' : 'is-out-of-stock'}`} data-product-stock={product.id} aria-label={product.inStock ? 'Producto en stock' : 'Producto sin stock'} title={product.inStock ? 'Producto en stock' : 'Producto sin stock'}>
								<span class="stock-dot" aria-hidden="true"></span>
								<span data-stock-text>{product.inStock ? 'En stock' : 'Sin stock'}</span>
							</span>
						</div>
						<p class="product-headline">{product.headline}</p>
						<p class="product-intro">{product.intro}</p>

						<div class="product-price-card">
							<div>
								<p class="price-label">Precio</p>
								<strong data-product-price={product.id}>{product.displayPrice}</strong>
							</div>
							<span class="product-tag">{product.tag}</span>
						</div>

						<div class="product-actions">
							<button type="button" class="primary-button" data-cart-add data-product-id={product.id} data-in-stock={product.inStock}>Añadir al carrito</button>
							<a class="secondary-button" href="/shop">Seguir comprando</a>
						</div>

						<div class="product-meta-grid">
							<div class="meta-card">
								<h2>Tallas</h2>
								<div class="option-row" data-option-group="size">
									{
										product.sizes.map((size, index) => (
											<button
												type="button"
												class={`option-chip ${index === 0 ? 'is-selected' : ''}`}
												data-option-button
												aria-pressed={index === 0 ? 'true' : 'false'}
											>
												{size}
											</button>
										))
									}
								</div>
							</div>

							<div class="meta-card">
								<h2>Colores</h2>
								<div class="option-row" data-option-group="color">
									{
										product.colors.map((color, index) => (
											<button
												type="button"
												class={`option-chip ${index === 0 ? 'is-selected' : ''}`}
												data-option-button
												aria-pressed={index === 0 ? 'true' : 'false'}
											>
												{color}
											</button>
										))
									}
								</div>
							</div>
						</div>
					</div>
				</section>

				<section class="product-info-grid">
					<article class="info-card info-card-wide">
						<p class="section-kicker">Descripción</p>
						<h2>Una ficha escalable basada en datos</h2>
						<p>{product.longDescription}</p>

						<div class="benefit-list">
							{product.benefits.map((benefit) => <div class="benefit-item">{benefit}</div>)}
						</div>
					</article>

					<article class="info-card">
						<p class="section-kicker">Detalles</p>
						<h2>Características destacadas</h2>
						<div class="feature-list">
							{
								product.features.map((feature) => (
									<div class="feature-item">
										<h3>{feature.title}</h3>
										<p>{feature.description}</p>
									</div>
								))
							}
						</div>
					</article>

					<article class="info-card">
						<p class="section-kicker">Cuidado</p>
						<h2>Cómo mantenerla mejor</h2>
						<ul class="plain-list">
							{product.care.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				</section>

				{product.reviews.length > 0 && (
					<section class="product-reviews">
						<div class="section-heading">
							<p class="section-kicker">Reseñas</p>
							<h2>Lo que transmite al usarla</h2>
						</div>

						<div class="review-grid">
							{
								product.reviews.map((review) => (
									<article class="review-card">
										<p class="review-comment">"{review.comment}"</p>
										<div class="review-author">
											<strong>{review.author}</strong>
											<span>{review.role}</span>
										</div>
									</article>
								))
							}
						</div>
					</section>
				)}

				<section class="product-reviews customer-reviews" data-product-reviews={product.id}>
					<div class="section-heading">
						<p class="section-kicker">Comentarios</p>
						<h2>Cuenta tu experiencia</h2>
					</div>

					<form class="review-form" data-review-form>
						<!-- <label>
							<span>Nombre</span>
							<input name="name" maxlength="60" placeholder="Tu nombre" autocomplete="name" />
						</label> -->

						<fieldset class="rating-field">
							<legend>Puntuación</legend>
							<div class="rating-options">
								{[5, 4, 3, 2, 1].map((rating) => (
									<label>
										<input type="radio" name="rating" value={rating} checked={rating === 5} required />
										<span>{String.fromCharCode(9733).repeat(rating)}</span>
									</label>
								))}
							</div>
						</fieldset>

						<label class="review-comment-field">
							<span>Comentario</span>
							<textarea name="comment" minlength="8" maxlength="600" rows="4" placeholder="¿Qué te ha parecido este producto?" required></textarea>
						</label>

						<button class="primary-button" type="submit">Publicar comentario</button>
						<p class="review-status" data-review-status aria-live="polite"></p>
					</form>

					<div class="review-grid user-review-grid" data-user-review-list></div>
				</section>

				{product.faqs.length > 0 && (
					<section class="product-faqs">
						<div class="section-heading">
							<p class="section-kicker">Preguntas frecuentes</p>
							<h2>Información rápida antes de comprar</h2>
						</div>

						<div class="faq-list">
							{
								product.faqs.map((faq) => (
									<article class="faq-card">
										<h3>{faq.question}</h3>
										<p>{faq.answer}</p>
									</article>
								))
							}
						</div>
					</section>
				)}

				{relatedProducts.length > 0 && (
					<section class="related-products">
						<div class="section-heading">
							<p class="section-kicker">También te puede gustar</p>
							<h2>Más opciones dentro de la tienda</h2>
						</div>

						<div class="related-grid">
							{
								relatedProducts.map((relatedProduct) => (
									<a class="related-card" href={relatedProduct.link ?? '/shop'}>
										<div
											class="related-image"
											role="img"
											aria-label={relatedProduct.name}
											data-product-image={relatedProduct.id}
											style={`background-image: url('${relatedProduct.image ?? ''}');`}
										></div>
										<div class="related-copy">
											<span class="product-tag">{relatedProduct.tag}</span>
											<h3 data-product-name={relatedProduct.id}>{relatedProduct.name}</h3>
											<p>{relatedProduct.description}</p>
											<strong data-product-price={relatedProduct.id}>{relatedProduct.displayPrice}</strong>
										</div>
									</a>
								))
							}
						</div>
					</section>
				)}
			</main>
		</div>
		<div class="product-lightbox" data-product-lightbox hidden>
			<div class="product-lightbox-backdrop" data-lightbox-close></div>
			<div class="product-lightbox-dialog" role="dialog" aria-modal="true" aria-label={`Galería de ${product.name}`}>
				<button class="lightbox-close" type="button" data-lightbox-close aria-label="Cerrar visor">x</button>
				<button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Imagen anterior">‹</button>
				<div class="lightbox-stage">
					<img src={primaryImage} alt={product.name} data-lightbox-image />
				</div>
				<button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Imagen siguiente">›</button>
				<div class="lightbox-controls" aria-label="Controles de zoom">
					<button type="button" data-lightbox-zoom-out aria-label="Disminuir imagen">-</button>
					<span data-lightbox-zoom>100%</span>
					<button type="button" data-lightbox-zoom-in aria-label="Ampliar imagen">+</button>
				</div>
			</div>
		</div>
		<CartDrawer />
	</body>
</html>

<script>
	import { initThemeToggle } from '../../scripts/theme-toggle.js';
	import { initMenuToggle } from '../../scripts/menu-toggle.js';
	import { initProductReviews } from '../../scripts/product-reviews.js';
	import { initBarMenuScroll } from '../../scripts/bar-menu-scroll.js';
	import { initProductGallery } from '../../scripts/product-gallery.js';

	initBarMenuScroll();
	initThemeToggle();
	initMenuToggle();
	initProductReviews();
	initProductGallery();

	document.querySelectorAll('[data-option-group]').forEach((group) => {
		const buttons = group.querySelectorAll('[data-option-button]');

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				buttons.forEach((item) => {
					item.classList.remove('is-selected');
					item.setAttribute('aria-pressed', 'false');
				});

				button.classList.add('is-selected');
				button.setAttribute('aria-pressed', 'true');
			});
		});
	});
</script>
