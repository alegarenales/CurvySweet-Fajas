---
// El identificador de sesión llega en la URL, así que es texto controlado por
// quien abre la página: solo lo aceptamos si tiene la forma que emite Stripe.
// El endpoint `/api/checkout-session` vuelve a comprobarlo por su cuenta.
const rawSessionId = Astro.url.searchParams.get("session_id") ?? "";
const sessionId = /^cs_[A-Za-z0-9_]{1,200}$/.test(rawSessionId) ? rawSessionId : "";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/curvysweet.ico" />
    <title>Pago confirmado | CurvySweet</title>
  </head>
  <body>
    <main class="status-page" data-checkout-session={sessionId}>
      <section class="status-card">
        <p class="status-kicker">CurvySweet</p>
        <h1>Pago confirmado</h1>
        <p>Tu compra fue procesada correctamente.</p>
        {sessionId && <p class="session-id">ID de sesión: <code>{sessionId}</code></p>}
        <a href="/">Volver a la tienda</a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    min-height: 100%;
    font-family: "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top left, rgba(255, 199, 221, 0.85), transparent 28%),
      radial-gradient(circle at 85% 18%, rgba(255, 223, 205, 0.9), transparent 26%),
      linear-gradient(135deg, #fff7fc, #fff0eb);
    color: #2b1630;
  }

  .status-page {
    min-height: 100vh;
    padding: 20px;
    display: grid;
    place-items: center;
    box-sizing: border-box;
  }

  .status-card {
    width: min(100%, 560px);
    padding: 28px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 24px 70px rgba(154, 73, 116, 0.16);
    backdrop-filter: blur(20px);
  }

  .status-kicker {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.76rem;
    font-weight: 800;
    color: #c93178;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 8vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0;
    line-height: 1.7;
    color: #6d5568;
  }

  .session-id {
    margin-top: 14px;
    overflow-wrap: anywhere;
  }

  code {
    display: inline-block;
    margin-top: 6px;
    padding: 6px 8px;
    border-radius: 10px;
    background: rgba(201, 49, 120, 0.08);
    color: #8f1d58;
  }

  a {
    display: inline-flex;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, #e45596, #c93178);
    color: white;
    text-decoration: none;
    font-weight: 800;
  }

  @media (max-width: 480px) {
    .status-page {
      padding: 14px;
    }

    .status-card {
      padding: 22px 18px;
      border-radius: 22px;
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
</style>

{/*
  Sin `define:vars`: esa directiva obliga a Astro a dejar el script en línea en
  el HTML, y la política de seguridad de contenido prohíbe el JavaScript en
  línea. El identificador se pasa por un atributo `data-` y Astro puede
  empaquetar el script como fichero externo del propio dominio.
*/}
<script>
  const readJson = (key, fallback) => {
    try {
      return JSON.parse(localStorage.getItem(key) || "") ?? fallback;
    } catch {
      return fallback;
    }
  };

  const sessionId = document.querySelector("[data-checkout-session]")?.dataset.checkoutSession ?? "";
  const user = readJson("curvysweetUser", null);

  if (sessionId && user) {
    fetch(`/api/checkout-session?session_id=${encodeURIComponent(sessionId)}`)
      .then((response) => response.json())
      .then((result) => {
        if (!result.ok || !result.order) return;

        const identity = String(user.mail || user.username || "guest").trim().toLowerCase();
        const storageKey = `curvysweetOrders:${identity}`;
        const orders = readJson(storageKey, []);

        if (!orders.some((order) => order.id === result.order.id)) {
          orders.unshift(result.order);
          localStorage.setItem(storageKey, JSON.stringify(orders));
        }
      })
      .catch(() => {});
  }
</script>
