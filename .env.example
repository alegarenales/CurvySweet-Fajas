# Correos con acceso al panel de administración, separados por comas.
# Quitar un correo de aquí revoca su sesión de administrador al instante.
ADMIN_EMAILS=tu_correo_admin@gmail.com

# ---------------------------------------------------------------------------
# Secretos de firma de sesión. OBLIGATORIOS en producción.
#
# Con ellos se firman las cookies `curvysweet_user` y `curvysweet_admin`. Quien
# conozca uno de estos valores puede fabricar una cookie válida para cualquier
# usuario o para el panel de administración, así que:
#
#   - Deben tener 32 caracteres como mínimo (el despliegue falla si no).
#   - Deben ser distintos entre sí y distintos en cada entorno.
#   - No se comparten ni se suben al repositorio.
#
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
USER_SESSION_SECRET=genera_un_valor_aleatorio_de_al_menos_32_caracteres
ADMIN_SESSION_SECRET=genera_otro_valor_aleatorio_de_al_menos_32_caracteres
